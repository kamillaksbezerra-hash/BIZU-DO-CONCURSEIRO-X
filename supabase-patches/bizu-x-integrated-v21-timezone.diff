+const BIZU_TIME_ZONE = "America/Sao_Paulo";
+
+function businessDateSaoPaulo(value: Date | string | number = new Date()) {
+  const date = value instanceof Date ? value : new Date(value);
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: BIZU_TIME_ZONE,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(date);
+  const map = Object.fromEntries(parts.map((part) => [part.type, part.value]));
+  return `${map.year}-${map.month}-${map.day}`;
+}
+
+function businessDateOrdinal(value: string) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value || ""));
+  if (!match) return null;
+  const ordinal = Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
+  return Number.isFinite(ordinal) ? ordinal / 86_400_000 : null;
+}
+
+function businessDaysUntil(value: string) {
+  const target = businessDateOrdinal(value);
+  const today = businessDateOrdinal(businessDateSaoPaulo());
+  if (target === null || today === null) return null;
+  return Math.max(0, Math.ceil(target - today));
+}
