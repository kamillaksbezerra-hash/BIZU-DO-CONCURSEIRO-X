{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fix/private-proxy-css-2026-09-06": true,
      "fix/stale-session-login-2026-09-06": false,
      "fix/private-loading-timeout-2026-09-06": false,
      "fix/login-input-focus-2026-09-06": false,
      "recovery/production-2026-09-06": false,
      "fix/admin-route-2026-09-06": false
    }
  },
  "rewrites": [
    {
      "source": "/private/app",
      "destination": "/api/private-page?mode=student"
    },
    {
      "source": "/private/admin",
      "destination": "/api/private-page?mode=admin"
    },
    {
      "source": "/api/study-planner",
      "destination": "https://xizvzwvvtfavsxtyosso.supabase.co/functions/v1/bizu-cronograma-x-e2e-v2-temp"
    },
    {
      "source": "/api/study-timer",
      "destination": "https://xizvzwvvtfavsxtyosso.supabase.co/functions/v1/bizu-create-student-test"
    },
    {
      "source": "/api/actions/:path*",
      "destination": "https://xizvzwvvtfavsxtyosso.supabase.co/functions/v1/bizu-x-actions-api/:path*"
    },
    {
      "source": "/api/file",
      "destination": "https://xizvzwvvtfavsxtyosso.supabase.co/functions/v1/bizu-asset-readonly-temp"
    },
    {
      "source": "/api/:path*",
      "destination": "https://xizvzwvvtfavsxtyosso.supabase.co/functions/v1/bizu-x-api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "same-origin"}
      ]
    },
    {
      "source": "/",
      "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]
    },
    {
      "source": "/admin",
      "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]
    },
    {
      "source": "/private/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"no-store, max-age=0"},
        {"key":"Content-Type","value":"text/html; charset=utf-8"}
      ]
    }
  ]
}
