{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "main": false,
      "recovery/production-2026-09-06": true
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://xizvzwvvtfavsxtyosso.supabase.co/functions/v1/bizu-x-api/:path*"
    },
    {
      "source": "/private/admin",
      "destination": "https://xizvzwvvtfavsxtyosso.supabase.co/functions/v1/bizu-x-private-ui/admin"
    },
    {
      "source": "/private/:path*",
      "destination": "https://xizvzwvvtfavsxtyosso.supabase.co/functions/v1/bizu-x-private-ui/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
